# Milestone 1 is a RAM-only, software-controlled tether test.
M1N1DEVICE="${M1N1DEVICE:-}"
MILESTONE1_OUTPUT_ROOT="${MILESTONE1_OUTPUT_ROOT:-}"
M1_KERNEL_RELATIVE=linux-full/latest/Image
M1_DTB_RELATIVE=linux-full/latest/dtbs/apple/t6030-j514s.dtb
M1_M1N1_SOURCE_DIR="${M1_M1N1_SOURCE_DIR:-}"
M1_M1N1_TOOL_RELATIVE=proxyclient/tools/linux.py
M1_COMPRESSION=none
M1_REQUIRED_BOOT_COUNT=20
M1_PREFLIGHT_MAX_AGE_SECONDS=900
M1_TARGET_MODEL=Mac15,6
M1_TARGET_BOARD=J514s
M1_TARGET_READINESS_MAX_AGE_SECONDS=900
M1_READINESS_SCRIPT=/Users/moriz/Projects/asahi-arch-hyprland-lab/scripts/check-native-readiness.sh
M1_READINESS_SCRIPT_SHA256=b7d11cd77db626a73f968815fdb78a2d3669cd0ba15741009dce1648884a6be9
M1_INITRAMFS_NAME=milestone1-initramfs.cpio.gz
M1_BUSYBOX_PACKAGE=busybox-static
M1_BUSYBOX_VERSION=1:1.35.0-4+deb12u1+b1
