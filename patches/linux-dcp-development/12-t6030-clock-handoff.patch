+static int dcp_get_display_clocks(struct apple_dcp *dcp)
+{
+	struct device *dev = dcp->dev;
+	struct clk *pixel, *video;
+
+	if (!of_device_is_compatible(dev->of_node, "apple,t6030-dcp"))
+		return 0;
+	if (!of_machine_is_compatible("apple,j514s") ||
+	    dcp->fw_compat != DCP_FIRMWARE_V_14_7)
+		return dev_err_probe(dev, -ENODEV, "Unverified T6030 clock contract\n");
+
+	pixel = devm_clk_get(dev, "pixel");
+	if (IS_ERR(pixel))
+		return dev_err_probe(dev, PTR_ERR(pixel), "Unable to find pixel clock\n");
+	video = devm_clk_get(dev, "video");
+	if (IS_ERR(video))
+		return dev_err_probe(dev, PTR_ERR(video), "Unable to find video clock\n");
+
+	/* A zero rate is a valid firmware fallback value, not a missing clock. */
+	dcp->clk = pixel;
+	dcp->video_clk = video;
+	return 0;
 }
 
