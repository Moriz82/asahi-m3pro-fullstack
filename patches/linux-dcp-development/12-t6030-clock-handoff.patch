+#if DCP_FW_VER == DCP_FW_VERSION(14, 7, 0)
+static u64 dcpep_cb_get_frequency(struct apple_dcp *dcp,
+				struct dcp_get_frequency_req *req)
+{
+	if (of_device_is_compatible(dcp->dev->of_node, "apple,t6030-dcp")) {
+		if (req->provider != 0x50524f56 || req->index > 1) {
+			dev_warn(dcp->dev, "Invalid display clock request\n");
+			return 0;
+		}
+		return clk_get_rate(req->index ? dcp->video_clk : dcp->clk);
+	}
+	return clk_get_rate(dcp->clk);
+}
+#else
 static u64 dcpep_cb_get_frequency(struct apple_dcp *dcp)
 {
 	return clk_get_rate(dcp->clk);
 }
+#endif
 
