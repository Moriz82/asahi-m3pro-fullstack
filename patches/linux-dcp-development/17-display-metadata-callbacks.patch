@@ -733,11 +733,24 @@ static struct DCP_FW_NAME(dcp_rt_bandwidth) dcpep_cb_rt_bandwidth(struct apple_d
 	return rt_bw;
 }
 
-static struct dcp_set_frame_sync_props_resp
+static struct DCP_FW_NAME(dcp_set_frame_sync_props_resp)
 dcpep_cb_set_frame_sync_props(struct apple_dcp *dcp,
-			      struct dcp_set_frame_sync_props_req *req)
+			      struct DCP_FW_NAME(dcp_set_frame_sync_props_req) *req)
 {
-	return (struct dcp_set_frame_sync_props_resp){};
+	struct DCP_FW_NAME(dcp_set_frame_sync_props_resp) resp = {};
+
+#if DCP_FW_VER == DCP_FW_VERSION(14, 7, 0)
+	if (!req->frame_sync_props_null) {
+		resp.props = req->props;
+		/* Metadata receipt only: no brightness policy or hardware write. */
+		for (unsigned int i = 0; i < 11; i++)
+			if (resp.props.updated[i])
+				dev_dbg(dcp->dev, "frame sync property %u: %u\n",
+					i, resp.props.values[i]);
+		memset(resp.props.updated, 0, sizeof(resp.props.updated));
+	}
+#endif
+	return resp;
 }
 
 /* Callback to get the current time as milliseconds since the UNIX epoch */
@@ -1087,6 +1100,23 @@ static void dcpep_cb_hotplug(struct apple_dcp *dcp, u64 *connected)
 	}
 }
 
+#if DCP_FW_VER == DCP_FW_VERSION(14, 7, 0)
+static struct DCP_FW_NAME(dcp_hotplug_resp)
+dcpep_cb_hotplug_metadata(struct apple_dcp *dcp,
+			 struct DCP_FW_NAME(dcp_hotplug_req) *req)
+{
+	struct DCP_FW_NAME(dcp_hotplug_resp) resp = {};
+	u64 connected = req->connected;
+
+	/* Opaque in/out metadata must survive even an ignored hotplug event. */
+	if (!req->tiled_display_null)
+		memcpy(resp.tiled_display, req->tiled_display,
+		       sizeof(resp.tiled_display));
+	dcpep_cb_hotplug(dcp, &connected);
+	return resp;
+}
+#endif
