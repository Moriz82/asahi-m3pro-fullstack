@@ -1163,7 +1193,13 @@ TRAMPOLINE_INOUT(trampoline_get_frequency, dcpep_cb_get_frequency,
 TRAMPOLINE_OUT(trampoline_get_frequency, dcpep_cb_get_frequency, u64);
