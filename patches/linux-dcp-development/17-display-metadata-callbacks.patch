diff --git a/drivers/gpu/drm/apple/iomfb_template.h b/drivers/gpu/drm/apple/iomfb_template.h
index aab131c..8386241 100644
--- a/drivers/gpu/drm/apple/iomfb_template.h
+++ b/drivers/gpu/drm/apple/iomfb_template.h
@@ -17,6 +17,42 @@
 #include "plane.h"
 #include "version_utils.h"
 
+struct DCP_FW_NAME(frame_sync_props) {
+#if DCP_FW_VER == DCP_FW_VERSION(14, 7, 0)
+	/* 23J220: eleven u32 properties followed by eleven update flags. */
+	u32 values[11];
+	u8 updated[11];
+	u8 reserved;
+#else
+	u8 unk[28];
+#endif
+} __packed;
+
+struct DCP_FW_NAME(dcp_set_frame_sync_props_req) {
+	struct DCP_FW_NAME(frame_sync_props) props;
+	u8 frame_sync_props_null;
+	u8 padding[3];
+} __packed;
+
+struct DCP_FW_NAME(dcp_set_frame_sync_props_resp) {
+	struct DCP_FW_NAME(frame_sync_props) props;
+} __packed;
+
+#if DCP_FW_VER == DCP_FW_VERSION(14, 7, 0)
+struct DCP_FW_NAME(dcp_hotplug_req) {
+	u64 connected;
+	u8 tiled_display[75];
+	u8 unkbool;
+	u8 tiled_display_null;
+	u8 padding[3];
+} __packed;
+
+struct DCP_FW_NAME(dcp_hotplug_resp) {
+	u8 tiled_display[75];
+	u8 padding;
+} __packed;
+#endif
+
 struct DCP_FW_NAME(dcp_swap_start_req) {
 	u32 swap_id;
 #if DCP_FW_VER == DCP_FW_VERSION(14, 7, 0)
