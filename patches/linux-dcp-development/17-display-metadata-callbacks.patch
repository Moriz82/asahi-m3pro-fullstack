Subject: [PATCH 17] drm/apple: preserve 23J220 display callback metadata

Development-only against 77cb8f24c2381a8abb7272d7bbdec548d6426a8a and the preceding
selected development patches. Exact firmware/host D006 is 60/56 bytes;
D576 is 88/76 bytes. Preserve values/opaque metadata in in/out replies,
acknowledge frame property flags, and validate target sizes before dispatch.
Metadata receipt only: brightness policy and multi-pipe tiling remain absent.
Older layouts are retained. No boot-builder or hardware enablement change.

diff --git a/drivers/gpu/drm/apple/iomfb.c b/drivers/gpu/drm/apple/iomfb.c
index 9a64abf..3a54a58 100644
--- a/drivers/gpu/drm/apple/iomfb.c
+++ b/drivers/gpu/drm/apple/iomfb.c
@@ -307,6 +307,15 @@ static void dcpep_handle_cb(struct apple_dcp *dcp, enum dcp_context_id context,
 		dev_warn(dev, "Invalid display clock callback size\n");
 		return;
 	}
+	/* 23J220 in/out metadata callbacks overwrite firmware-owned values. */
+	if (dcp->fw_compat == DCP_FIRMWARE_V_14_7 &&
+	    ((tag == 6 && (hdr->in_len != 60 || hdr->out_len != 56 ||
+			   length != sizeof(*hdr) + 60 + 56)) ||
+	     (tag == 576 && (hdr->in_len != 88 || hdr->out_len != 76 ||
+			     length != sizeof(*hdr) + 88 + 76)))) {
+		dev_warn(dev, "Invalid display metadata callback size\n");
+		return;
+	}
 	/* 23J220 D589 has 34-byte data, eight 216-byte records and flags. */
 	if (tag == 589 && dcp->fw_compat == DCP_FIRMWARE_V_14_7 &&
 	    (hdr->in_len != 1776 || hdr->out_len != 0 ||
