Subject: [PATCH 16] drm/apple: correct 23J220 swap-completion wire contract

Development-only, against Linux pin 77cb8f24c2381a8abb7272d7bbdec548d6426a8a
plus patches 01-15. Exact T6030 firmware sender 0x13ead8 serializes 1776
bytes: 34-byte completion data, eight 216-byte records, count and flags.
Reject mismatched V14.7 D589 payload lengths before typed dispatch. Preserve
older layouts and callback acceptance. No display enablement or boot change.

diff --git a/drivers/gpu/drm/apple/iomfb.c b/drivers/gpu/drm/apple/iomfb.c
--- a/drivers/gpu/drm/apple/iomfb.c
+++ b/drivers/gpu/drm/apple/iomfb.c
@@ -307,6 +307,13 @@
 		dev_warn(dev, "Invalid display clock callback size\n");
 		return;
 	}
+	/* 23J220 D589 has 34-byte data, eight 216-byte records and flags. */
+	if (tag == 589 && dcp->fw_compat == DCP_FIRMWARE_V_14_7 &&
+	    (hdr->in_len != 1776 || hdr->out_len != 0 ||
+	     length != sizeof(*hdr) + 1776)) {
+		dev_warn(dev, "Invalid swap completion callback size\n");
+		return;
+	}
 
 	if (tag < 0 || tag >= IOMFB_MAX_CB || !dcp->cb_handlers || !dcp->cb_handlers[tag]) {
 		dev_warn(dev, "received unknown callback %c%c%c%c\n",
diff --git a/drivers/gpu/drm/apple/iomfb_template.h b/drivers/gpu/drm/apple/iomfb_template.h
--- a/drivers/gpu/drm/apple/iomfb_template.h
+++ b/drivers/gpu/drm/apple/iomfb_template.h
@@ -203,6 +203,15 @@
 struct DCP_FW_NAME(dc_swap_complete_resp) {
 	u32 swap_id;
 	u8 unkbool;
+#if DCP_FW_VER == DCP_FW_VERSION(14, 7, 0)
+	/* 23J220 D589: inline completion data, eight 216-byte records. */
+	u8 swap_data[0x22];
+	u8 swap_info[0x6c0];
+	u32 unkint;
+	u8 unkbool2;
+	u8 swap_data_null;
+	u8 padding[3];
+#else
 	u64 swap_data;
 #if DCP_FW_VER < DCP_FW_VERSION(13, 2, 0)
 	u8 swap_info[0x6c4];
@@ -211,6 +220,7 @@
 #endif
 	u32 unkint;
 	u8 swap_info_null;
+#endif
 } __packed;
 
 struct DCP_FW_NAME(dcp_map_reg_req) {
