+/* Copy before ACK: callbacks may poll again and firmware may immediately recycle
+ * the shared ring. This copy remains owned by the caller until free(). */
+static int afk_epic_read(afk_epic_ep_t *epic, struct afk_qe **message)
+{
+    struct afk_qe *shared;
+    *message = NULL;
+    if (afk_epic_rx(epic, &shared) < 0)
+        return -1;
+
+    u32 size = epic->rx.pending_size;
+    struct afk_qe *copy = malloc(sizeof(*copy) + size);
+    if (!copy) {
+        epic->rx.failed = true;
+        return -1;
+    }
+    memcpy(copy, shared, sizeof(*copy) + size);
+    if (copy->magic != QE_MAGIC || copy->size != size) {
+        epic->rx.failed = true;
+        free(copy);
+        return -1;
+    }
+
+    afk_epic_rx_ack(epic);
+    if (epic->rx.failed) {
+        free(copy);
+        return -1;
+    }
+    *message = copy;
+    return 0;
+}
+
+static bool afk_epic_decode(struct afk_qe *message, struct epic_sub_hdr **sub, void **payload)
+{
+    if (message->size < sizeof(struct epic_hdr) + sizeof(struct epic_sub_hdr))
+        return false;
+    struct epic_hdr *hdr = (void *)message->data;
+    *sub = (void *)(hdr + 1);
+    if (hdr->version != 2 || (*sub)->version != 4 ||
+        (*sub)->length > message->size - sizeof(*hdr) - sizeof(**sub) ||
+        (*sub)->inline_len > (*sub)->length)
+        return false;
+    *payload = *sub + 1;
+    return true;
+}
