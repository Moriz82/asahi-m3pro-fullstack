+                FIELD_GET(DART_T8110_PARAMS1_PAGE_SHIFT, params1) != 14 ||
+                FIELD_GET(DART_T8110_PARAMS3_PA_WIDTH, params3) != 42 ||
+                bits <= 36 || bits > 47) {
+                printf("dart: unsupported retained four-level configuration\n");
+                free(dart);
+                return NULL;
+            }
+            dart->four_levels = true;
+            dart->iova_bits = bits;
+        }
+    }
+
     if (dart->locked || keep_pts) {
         for (int i = 0; i < dart->params->ttbr_count; i++) {
             u32 ttbr = read32(DART_TTBR(dart, i));
@@ -353,7 +387,7 @@ dart_dev_t *dart_init_adt(const char *path, int instance, int device, bool keep_
