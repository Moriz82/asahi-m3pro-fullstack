     dart->keep = keep_pts;
 
+    /* Retained T8110 tables must be walked in their existing mode. The
+     * hardware's level count includes the TTBR, so FOUR_LEVEL adds one
+     * memory table above the usual two. Fresh contexts still use two.
+     */
+    if (type == DART_T8110 && (dart->locked || keep_pts)) {
+        u32 tcr = read32(DART_TCR(dart));
+        if (tcr & DART_T8110_TCR_FOUR_LEVEL) {
+            u32 params1 = read32(base + DART_T8110_PARAMS1);
+            u32 params3 = read32(base + DART_T8110_PARAMS3);
+            u32 bits = FIELD_GET(DART_T8110_PARAMS3_VA_WIDTH, params3);
