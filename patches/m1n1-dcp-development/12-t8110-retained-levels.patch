+static void dart_release_tables(dart_dev_t *dart, u64 *table, unsigned levels)
+{
+    if (levels == 1)
+        return; /* Leaf entries name physical buffers, not allocated tables. */
+    unsigned entries = levels == 3 ? 1U << (dart->iova_bits - 36) : SZ_16K / sizeof(u64);
+    for (unsigned i = 0; i < entries; i++) {
+        if (!(table[i] & DART_PTE_VALID))
+            continue;
+        u64 *child = dart_pte_table(dart, table[i]);
+        if (!child)
+            continue;
+        dart_release_tables(dart, child, levels - 1);
+        if (is_heap(child)) {
+            table[i] = 0;
+            dart->params->tlb_invalidate(dart);
+            free(child);
+        }
+    }
+}
+
