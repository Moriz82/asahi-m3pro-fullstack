From: M3 Pro development program
Subject: [PATCH] m1n1: validate retained mapping extents and full IOVA root index

Development-only prerequisite for display handoff. Matching endpoint
translations cannot establish a contiguous mapping across interior pages.
Reject invalid extents and unsupported high IOVAs without aliasing low roots.
This does not add T8110 four-level support or change missing-mapping policy.

diff --git a/src/dart.c b/src/dart.c
index 63908d7..a54886d 100644
--- a/src/dart.c
+++ b/src/dart.c
@@ -645,16 +645,17 @@ void dart_free_l2(dart_dev_t *dart, uintptr_t iova)
 
 static void *dart_translate_internal(dart_dev_t *dart, uintptr_t iova, int silent)
 {
-    u32 ttbr = (iova >> 36) & 0x3;
+    u64 ttbr = iova >> 36;
     u32 l1_index = (iova >> 25) & 0x7ff;
 
-    if ((int)ttbr >= dart->params->ttbr_count) {
-        printf("dart[%lx %u]: ttbr out of range: %d\n", dart->regs, dart->device, ttbr);
+    if (ttbr >= (unsigned)dart->params->ttbr_count) {
+        printf("dart[%lx %u]: ttbr out of range: %llu\n", dart->regs, dart->device,
+               (unsigned long long)ttbr);
         return NULL;
     }
 
     if (!dart->l1[ttbr]) {
-        printf("dart[%lx %u]: l1[%u] is not set\n", dart->regs, dart->device, ttbr);
+        printf("dart[%lx %u]: l1[%u] is not set\n", dart->regs, dart->device, (unsigned)ttbr);
         return NULL;
     }
 
diff --git a/src/kboot.c b/src/kboot.c
index 7fd271e..e669ff2 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -1403,18 +1403,44 @@ static dart_dev_t *dt_init_dart_by_node(int node, u32 num)
 
 static u64 dart_get_mapping(dart_dev_t *dart, const char *path, u64 paddr, size_t size)
 {
+    /* dart_search matches page bases; an empty or wrapping extent is not a mapping. */
+    if (!dart || !paddr || !size || (paddr & (SZ_16K - 1)) ||
+        size - 1 > UINT64_MAX - paddr) {
+        printf("ADT: %s has an invalid physical extent\n", path);
+        return DART_PTR_ERR;
+    }
+
     u64 iova = dart_search(dart, (void *)paddr);
     if (DART_IS_ERR(iova)) {
         printf("ADT: %s paddr: 0x%lx is not mapped\n", path, paddr);
         return iova;
     }
 
+    if (size - 1 > UINT64_MAX - iova) {
+        printf("ADT: %s has a wrapping IOVA extent\n", path);
+        return DART_PTR_ERR;
+    }
+
     u64 pend = (u64)dart_translate(dart, iova + size - 1);
     if (pend != (paddr + size - 1)) {
         printf("ADT: %s is not continuously mapped: 0x%lx\n", path, pend);
         return DART_PTR_ERR;
     }
 
+    /* Matching endpoints do not prove that intervening pages are present
+     * or map the corresponding physical pages. Inspect every covered page.
+     * The final partial page was also bounded by the last-byte check above.
+     */
+    for (u64 offset = 0;; offset += SZ_16K) {
+        u64 translated = (u64)dart_translate(dart, iova + offset);
+        if (translated != paddr + offset) {
+            printf("ADT: %s mapping is discontinuous at offset 0x%lx\n", path, offset);
+            return DART_PTR_ERR;
+        }
+        if (size - offset <= SZ_16K)
+            break;
+    }
+
     return iova;
 }
 
