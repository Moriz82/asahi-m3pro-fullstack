Subject: [PATCH] dcp: correct T6030 23J220 startup wire contracts

Development only. A406/A472 offsets are verified against the exact target
firmware. Older and hypothetical future profiles retain prior schemas.
No hardware activation.

diff --git a/proxyclient/m1n1/fw/dcp/ipc.py b/proxyclient/m1n1/fw/dcp/ipc.py
--- a/proxyclient/m1n1/fw/dcp/ipc.py
+++ b/proxyclient/m1n1/fw/dcp/ipc.py
@@ -794,7 +794,10 @@
     A423 = Call(uint32_t, "set_contrast", InOutPtr(Float32l))
 
     if Ver.check("V >= V14_7"):
-        A406 = Call(uint32_t, "swap_start", client=InOutPtr(IOUserClient))
+        if Ver.check("V == V14_7"):
+            A406 = Call(uint32_t, "swap_start", swap_id=InOutPtr(uint), client=ulong)
+        else:
+            A406 = Call(uint32_t, "swap_start", client=InOutPtr(IOUserClient))
         A407 = swap_submit_dcp
         A409 = Call(uint32_t, "set_display_device", uint)
         A410 = Call(bool_, "is_main_display")
@@ -833,7 +836,11 @@
     flush_supportsPower = Call(void, "flush_supportsPower", bool_)
     abort_swaps_dcp = Call(uint, "abort_swaps_dcp", InOutPtr(IOMobileFramebufferUserClient))
     update_dfb = Call(uint, "update_dfb", surf=InPtr(IOSurface))
-    setPowerState = Call(uint32_t, "setPowerState", ulong, bool_, OutPtr(uint))
+    if Ver.check("V == V14_7"):
+        # 23J220 A472: three boolean inputs, then the generated null flag.
+        setPowerState = Call(uint32_t, "setPowerState", ulong, bool_, bool_, OutPtr(uint), bool_)
+    else:
+        setPowerState = Call(uint32_t, "setPowerState", ulong, bool_, OutPtr(uint))
     isKeepOnScreen = Call(bool_, "isKeepOnScreen")
 
     if Ver.check("V < V13_5"):
