Subject: [DEVELOPMENT PATCH] proxyclient: correct 14.7 A407 request and reply

Use the actual six-secondary-surface layout and the existing automatic
pointer-null handling. Restore the missing uint32 output so status is read
at offset 5 in a 12-byte aligned reply, not offset 1 in eight bytes.
Verified offline against T6030 and T8122 23J220 firmware readers only.

--- a/proxyclient/m1n1/fw/dcp/ipc.py
+++ b/proxyclient/m1n1/fw/dcp/ipc.py
@@ -743,22 +743,17 @@
                 surfaces=Array(SWAP_SURFACES, InPtr(IOSurface)),
                 surfAddr=Array(SWAP_SURFACES, Hex(ulong)),
                 unkU64Array=Array(SWAP_SURFACES, Hex(ulong)),
-                surfaces2=Array(5, InPtr(IOSurface)),
-                surfAddr2=Array(5, Hex(ulong)),
+                # 23J220 T6030/T8122 A407 decodes six secondary surfaces.
+                surfaces2=Array(6, InPtr(IOSurface)),
+                surfAddr2=Array(6, Hex(ulong)),
                 unkBool=bool_,
                 unkFloat=Float64l,
                 unkU64=ulong,
                 unkBool2=bool_,
                 clear_surfs=Hex(uint),
-                unkAddr=Hex(uint),
-                swap_null=bool_,
-                surf_null=Array(SWAP_SURFACES, Bool(Int8ul)),
-                surf2_null=Array(5, Bool(Int8ul)),
                 unkOutBool=OutPtr(bool_),
-                unkU32Ptr_null=Hex(Int8ul),
-                unk32out_null=Hex(Int8ul),
-                padding=Hex(Int8ul),
-                unkb=UnkBytes(0x228))
+                unkCUintArray=InPtr(uint),
+                unkUintPtr=OutPtr(uint))
     elif Ver.check("V < V13_5"):
         swap_submit_dcp = Call(uint32_t, "swap_submit_dcp",
                  swap_rec=InPtr(IOMFBSwapRec),
