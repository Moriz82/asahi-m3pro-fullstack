+    if (!sz || sz - 1 > (u64)-1 - iova || (iova & rtk->dva_base))
+        return false;
+    u64 first_tag = rtk->dva_base & -rtk->dva_base;
+    return !first_tag || sz <= first_tag - (iova & (first_tag - 1));
