--- a/src/iova.h
+++ b/src/iova.h
@@ -8,11 +8,14 @@
 
 typedef struct iova_domain iova_domain_t;
 
+/* Exclusive page-aligned limit; base is 32 MiB aligned. Page zero is excluded. */
